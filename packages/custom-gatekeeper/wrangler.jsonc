{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "custom-gatekeeper",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat"],
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": ["CustomGatekeeper"]
    }
  ],
  // Secrets are installed on the Worker, never written here. DATABASE_URL: the radial_os connection
  // string for production (read-only replica). NEON_API_KEY: a Viewer-role Neon key that can list
  // branches and endpoints and nothing else; RADIAL_OS_DATABASE_PASSWORD: the role's password, the
  // same on every branch — together they let a read target another branch.
  "secrets": { "required": ["DATABASE_URL", "NEON_API_KEY", "RADIAL_OS_DATABASE_PASSWORD"] },
  "vars": {
    "CUSTOM_NAME": "Example organization",
    "CUSTOM_MESSAGE": "Replace this with information useful to your organization.",
    "NEON_PROJECT_ID": "replace-me"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
