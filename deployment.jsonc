{
  // Cloudflare account that owns every Worker and provisioned resource.
  // Find it: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
  "accountId": "624d34a0bb22778f8061cc71fefe58cc",

  // The deployment's public origin, used for PUBLIC_BASE_URL and to scope Context data.
  // null derives it from workers.router.route.customDomain.
  "publicBaseUrl": null,

  // Worker names are permanent service identities. Keep them unique within the account.
  // Reference: docs/customization.md#workers-and-routing
  "workers": {
    // Owns the public URL and serves the frontend. Proxies /api and /blueprint-screenshot to the
    // Workshop, /gatekeeper/<name> to the matching Gatekeeper, and inbound email to the email
    // Gatekeeper.
    "router": {
      "name": "radial-os-router",

      // Production: use a hostname in an active Cloudflare zone. Wrangler creates DNS and TLS.
      // Evaluation: replace this with "route": { "workersDev": true } and set publicBaseUrl above.
      // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
      "route": { "customDomain": "radial.zone" }
    },

    // The Workshop backend. No public route: the router reaches it over a service binding.
    "workshop": { "name": "radial-os" },
    "context": { "name": "radial-os-context" },

    // The Scheduler Gatekeeper, which gives agents scheduled and recurring work. Ambient like
    // the Context Gatekeeper.
    "scheduler": { "name": "radial-os-scheduler" },

    "customGatekeeper": { "name": "radial-os-gatekeeper" },
    "errorReporter": { "name": "radial-os-errors" }
  },

  // Additional upstream gatekeepers to deploy, keyed by vendor id (this wrapper's extension; the
  // Workshop, Context, Scheduler and custom Gatekeeper above are upstream's own). Each deploys as
  // its own Worker from the submodule, binds to the Workshop for vendor RPC, and is served by the
  // router at /gatekeeper/<id>. OAuth ones need CLIENT_ID and CLIENT_SECRET installed as secrets
  // on their Worker after the first deploy:
  //   wrangler secret put CLIENT_ID --name <worker-name>
  "gatekeepers": {
    "github": { "name": "radial-os-github" },
    "linear": { "name": "radial-os-linear" },
    "mcp": { "name": "radial-os-mcp" },
    // Admin-curated MCP servers via the Cloudflare MCP Server Portal (AI Controls -> "radial"
    // portal, endpoint mcp.radial.zone). Servers are added/authed in the portal, not here.
    "mcp_portal": {
      "name": "radial-os-mcp-portal",
      "vars": {
        "MCP_PORTAL_URL": "https://mcp.radial.zone/mcp",
        "MCP_PORTAL_NAME": "Radial MCP Portal",
        "MCP_PORTAL_AUTH": "oauth"
      }
    },
    "email": { "name": "radial-os-email" }
  },

  // This starter deploys Cloudflare Access mode. Cloudflare OS also supports built-in password
  // accounts and auth Gatekeeper sign-in; see the reference below before switching. The audience
  // comes from the self-hosted Access application protecting the public hostname.
  // "admins" gates /admin in every sign-in method.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://fancy-cell-d93d.cloudflareaccess.com",
    "audience": "13a0c8e64acde4dfb5b0cda4d43e983077bcaedd9e4e0a67534b9dba724e2017",
    "admins": ["kristo@radial.racing", "kristo.jorgenson@gmail.com"]
  },

  // Model catalog served through Cloudflare AI Gateway. The Workshop reaches the gateway over its
  // WORKERS_AI binding, which is pre-authenticated inside our own account, so no API token is
  // needed. Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": true,

    // Our own gateway, created for this deployment.
    "name": "radial-os",

    // null reuses the top-level accountId. Set only if the gateway lives in another account --
    // that requires CF_AI_GATEWAY_API_TOKEN, since the binding cannot reach across accounts.
    "accountId": null,

    // "cloudflare" is Workers AI, which needs no key of our own. Users add external-provider
    // models with their own keys (BYOK) in the UI.
    "providers": ["cloudflare"]
  },

  "context": {
    // Isolates Context data shared by this Workshop deployment. Set before upstream offered null;
    // the existing collections are scoped to this label, so changing it hides them.
    "sharingDomain": "production",

    // null: Wrangler provisions and remembers a KV namespace on first deploy.
    // string: bind an existing namespace by ID.
    "kvNamespaceId": "e5310604d43e4dde932e9298bbbd6c7e"
  },

  // Displayed to agents when the example custom integration is enabled in /admin.
  // Reference: docs/customization.md#custom-gatekeepers
  "customGatekeeper": {
    "name": "Radial",
    "message": "Radial is a pro-cycling fan app (radial.racing). Domain docs and code live in the Pro-Cycling-App GitHub org; the main monorepo is 'radial'.",
    // The Neon project whose branches a read may target (the Viewer key lists them).
    "neonProjectId": "nameless-boat-48742664"
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  // Set release to a commit/version when your deployment pipeline has one.
  // Reference: docs/observability.md#quick-start
  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // null values use Wrangler automatic provisioning. Set IDs/names to reuse owned resources.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  "resources": {
    "blueprintsKvNamespaceId": "f077208389674fcdbef22ffd684beb62",
    "avatarsKvNamespaceId": "5adb4089e9314bdb94f5de1c064568d6",
    "blueprintContentBucket": "radial-os-blueprint-content"
  },

  // Structured custom logs stay enabled. Invocation logs and traces are separate volume controls.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
